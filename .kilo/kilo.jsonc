{
  "$schema": "https://app.kilo.ai/config.json",

  "experimental": {
    "memoryBank": {
      "enabled": true,
      "maxTokens": 4096,
      "storage": "local"
    }
  },

  "instructions": [
    ".kilo/rules/agent-operating-principles.md"
  ],

  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/martinp/Documents/projects/aiassistant"
      ],
      "enabled": true,
      "timeout": 30000
    },

    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 15000
    },

    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true,
      "timeout": 30000
    }
  }
}